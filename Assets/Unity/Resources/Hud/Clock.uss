.hud-glass.hud-clock {
    position: absolute;
    right: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    padding: 5px 14px 7px 14px;
    background-color: var(--enamel);
    background-image: none;
    border-width: 2px;
    border-color: var(--enamel-rim);
    border-radius: 5px;
}

.hud-text.hud-clock__digit {
    width: 21px;
    font-size: 32px;
    color: var(--enamel-ink);
    -unity-text-align: middle-center;
}

.hud-text.hud-clock__colon {
    width: 10px;
    font-size: 32px;
    color: var(--enamel-ink-soft);
    -unity-text-align: middle-center;
}
