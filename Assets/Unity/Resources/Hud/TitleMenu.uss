.title-menu {
    transition-property: opacity;
    transition-duration: var(--slow);
    transition-delay: 0.35s;
    transition-timing-function: ease-out-cubic;
}

.title-screen--arriving .title-menu {
    opacity: 0;
}

.title-button {
    align-self: flex-start;
    flex-shrink: 0;
    min-width: 300px;
    margin: 0;
    padding: 4px 40px 4px 0;
    align-items: flex-start;
    border-width: 0;
}

.title-button__mark {
    position: absolute;
    left: -34px;
    top: 26px;
    width: 18px;
    height: 3px;
    background-color: var(--ember);
    opacity: 0;
    translate: -8px 0;
    transition-property: opacity, translate;
    transition-duration: var(--quick), var(--quick);
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.title-button:focus .title-button__mark {
    opacity: 1;
    translate: 0 0;
}

.hud-text.title-button__words {
    font-size: 40px;
    letter-spacing: 2px;
    color: var(--ink);
    -unity-font-definition: var(--face-headline);
    transition-property: color;
    transition-duration: var(--quick);
}

.title-button:focus .hud-text.title-button__words {
    color: var(--sunset);
}

.title-button:active .hud-text.title-button__words {
    color: var(--glow);
}

.hud-text.title-button__detail {
    margin-top: -3px;
    font-size: 17px;
    color: var(--ink-faint);
}

.title-button:focus .hud-text.title-button__detail {
    color: var(--ink-soft);
}
