.hud-job-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    align-items: center;
}

.hud-glass.hud-job {
    padding: 8px 22px 10px 22px;
    align-items: center;
    background-color: var(--paper);
    background-image: url("Materials/Paper.png");
    background-repeat: repeat;
    border-width: 1px;
    border-color: var(--paper-edge);
    border-radius: 3px;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.hud-job--hidden {
    opacity: 0;
    translate: 0 -12px;
}

.hud-job .hud-text.hud-eyebrow {
    color: var(--pencil-soft);
}

.hud-text.hud-job__words {
    margin-top: 2px;
    font-size: 28px;
    color: var(--pencil);
    -unity-font-definition: url("Fonts/Caveat-SemiBold.ttf");
}
