.hud-screen {
    --night: #0B0605;
    --umber: #1C0A06;
    --oxblood: #5A0D06;
    --brick: #8F2410;
    --ember: #D9692F;
    --sunset: #E8823F;
    --glow: #F6B166;
    --ink: #EFE4C8;
    --ink-soft: rgba(239, 228, 200, 0.74);
    --ink-faint: rgba(239, 228, 200, 0.46);
    --rule: rgba(239, 228, 200, 0.10);
    --oilskin: rgba(27, 25, 20, 0.93);
    --oilskin-deep: rgba(22, 20, 16, 0.96);
    --edge: rgba(239, 228, 200, 0.08);
    --edge-lit: rgba(239, 228, 200, 0.18);
    --brass: #C9A24A;
    --signal-red: #C04F36;
    --unlit: rgba(239, 228, 200, 0.18);
    --key-face: #17150F;
    --key-ring: #B8AE97;
    --key-ink: #EFE4C8;
    --enamel: #E6DEC7;
    --enamel-ink: #1E1B16;
    --enamel-ink-soft: rgba(30, 27, 22, 0.55);
    --enamel-rim: #5A5346;
    --paper: #E7DAB9;
    --paper-card: #F1E8D2;
    --paper-edge: #BFAE88;
    --pencil: #2F2A26;
    --pencil-soft: rgba(47, 42, 38, 0.66);
    --pencil-faint: rgba(47, 42, 38, 0.38);
    --pencil-rule: rgba(47, 42, 38, 0.16);
    --oilcloth: #1C1F1A;
    --oilcloth-edge: #3B4036;
    --gutter: rgba(0, 0, 0, 0.38);
    --table: rgba(6, 5, 4, 0.78);
    --scope-field: #050403;
    --scope-wire: #15110D;
    --face-headline: url("Fonts/LeagueGothic-Regular.ttf");
    --face-stencil: url("Fonts/StardosStencil-Regular.ttf");
    --face-stencil-bold: url("Fonts/StardosStencil-Bold.ttf");
    --face-hand: url("Fonts/Caveat-Regular.ttf");
    --face-hand-bold: url("Fonts/Caveat-SemiBold.ttf");
    --face-text: url("Fonts/Cabin-Regular.ttf");
    --face-text-medium: url("Fonts/Cabin-Medium.ttf");
    --face-text-bold: url("Fonts/Cabin-Bold.ttf");
    --face-figures: url("Fonts/JosefinSans-SemiBold.ttf");
    --quick: 0.12s;
    --brisk: 0.2s;
    --unhurried: 0.45s;
    --slow: 0.8s;
}
