.hud-speech-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
    align-items: center;
}

.hud-glass.hud-speech {
    width: 760px;
    padding: 14px 24px 16px 24px;
    background-color: var(--oilskin-deep);
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.hud-speech--hidden {
    opacity: 0;
    translate: 0 12px;
}

.hud-text.hud-speech__words {
    margin-top: 6px;
    font-size: 22px;
    white-space: normal;
    -unity-font-definition: url("Fonts/Cabin-Medium.ttf");
}
