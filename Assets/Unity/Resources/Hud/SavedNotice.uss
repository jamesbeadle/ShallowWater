.hud-saved-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.hud-glass.hud-saved {
    padding: 8px 22px;
    transition-property: opacity, translate;
    transition-duration: var(--brisk), var(--brisk);
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.hud-saved--hidden {
    opacity: 0;
    translate: 0 12px;
}
