.title-screen {
    --title-margin: 132px;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: var(--unhurried);
    transition-timing-function: ease-in-cubic;
}

.title-screen--leaving {
    opacity: 0;
}

.title__curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--night);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--slow);
    transition-timing-function: ease-out-cubic;
}

.title-screen--arriving .title__curtain {
    opacity: 1;
}

.title__curtain--drawn {
    opacity: 1;
    transition-duration: var(--brisk);
}

.hud-text.title__casting-off {
    font-size: 44px;
    color: var(--ink-soft);
    -unity-font-definition: var(--face-hand);
}
