@import url("Brand.uss");
@import url("KeyGlyphs.uss");
@import url("Prompts.uss");
@import url("ControlsPanel.uss");
@import url("Telegraph.uss");
@import url("Clock.uss");
@import url("Speech.uss");
@import url("Job.uss");
@import url("Sight.uss");
@import url("PocketBook.uss");
@import url("Sketches.uss");
@import url("SavedNotice.uss");
@import url("Title.uss");

.hud-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-safe-area {
    position: absolute;
    transition-property: opacity;
    transition-duration: var(--brisk);
    transition-timing-function: ease-out-cubic;
}

.hud-safe-area--reading {
    opacity: 0;
}

.hud-text {
    margin: 0;
    padding: 0;
    color: var(--ink);
    white-space: nowrap;
    -unity-font-style: normal;
    -unity-font-definition: var(--face-text);
}

.hud-text.hud-display {
    -unity-font-definition: var(--face-figures);
}

.hud-text.hud-eyebrow {
    font-size: 13px;
    letter-spacing: 3.5px;
    color: var(--ink-faint);
    -unity-font-definition: var(--face-stencil);
}

.hud-glass {
    background-color: var(--oilskin);
    background-image: url("Materials/Weave.png");
    background-repeat: repeat;
    border-width: 1px;
    border-color: var(--edge);
    border-top-color: var(--edge-lit);
    border-radius: 6px;
}
