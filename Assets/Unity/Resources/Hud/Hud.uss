@import url("KeyGlyphs.uss");
@import url("Prompts.uss");
@import url("ControlsPanel.uss");
@import url("Telegraph.uss");
@import url("Clock.uss");
@import url("Speech.uss");
@import url("Job.uss");
@import url("Sight.uss");
@import url("PocketBook.uss");
@import url("Sketches.uss");

.hud-screen {
    --ink: #EFE4C8;
    --ink-soft: rgba(239, 228, 200, 0.74);
    --ink-faint: rgba(239, 228, 200, 0.46);
    --rule: rgba(239, 228, 200, 0.10);
    --oilskin: rgba(27, 25, 20, 0.93);
    --oilskin-deep: rgba(22, 20, 16, 0.96);
    --edge: rgba(239, 228, 200, 0.08);
    --edge-lit: rgba(239, 228, 200, 0.18);
    --brass: #C9A24A;
    --signal-red: #C04F36;
    --unlit: rgba(239, 228, 200, 0.18);
    --key-face: #17150F;
    --key-ring: #B8AE97;
    --key-ink: #EFE4C8;
    --enamel: #E6DEC7;
    --enamel-ink: #1E1B16;
    --enamel-ink-soft: rgba(30, 27, 22, 0.55);
    --enamel-rim: #5A5346;
    --paper: #E7DAB9;
    --paper-card: #F1E8D2;
    --paper-edge: #BFAE88;
    --pencil: #2F2A26;
    --pencil-soft: rgba(47, 42, 38, 0.66);
    --pencil-faint: rgba(47, 42, 38, 0.38);
    --pencil-rule: rgba(47, 42, 38, 0.16);
    --oilcloth: #1C1F1A;
    --oilcloth-edge: #3B4036;
    --gutter: rgba(0, 0, 0, 0.38);
    --table: rgba(6, 5, 4, 0.78);
    --scope-field: #050403;
    --scope-wire: #15110D;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-safe-area {
    position: absolute;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.hud-safe-area--reading {
    opacity: 0;
}

.hud-text {
    margin: 0;
    padding: 0;
    color: var(--ink);
    white-space: nowrap;
    -unity-font-style: normal;
    -unity-font-definition: url("Fonts/Cabin-Regular.ttf");
}

.hud-text.hud-display {
    -unity-font-definition: url("Fonts/JosefinSans-SemiBold.ttf");
}

.hud-text.hud-eyebrow {
    font-size: 13px;
    letter-spacing: 3.5px;
    color: var(--ink-faint);
    -unity-font-definition: url("Fonts/StardosStencil-Regular.ttf");
}

.hud-glass {
    background-color: var(--oilskin);
    background-image: url("Materials/Weave.png");
    background-repeat: repeat;
    border-width: 1px;
    border-color: var(--edge);
    border-top-color: var(--edge-lit);
    border-radius: 6px;
}
